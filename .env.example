# ============================================================================
# Faro · Variables de entorno (desarrollo)
#
# Este archivo es la FUENTE ÚNICA DE VERDAD para variables de entorno de
# Faro. La página `docs/reference/environment.md` se autogenera a partir
# de aquí (`scripts/gen-env-reference.sh`). CI bloquea el merge si los dos
# archivos están desincronizados.
#
# Cuando agregues, renombres o cambies un default:
#   1) Edita esta sección, respetando el formato (header de sección
#      con `# ---- Nombre ----`, comentario descriptivo encima de cada
#      variable, una línea en blanco entre variables).
#   2) Corre `bash scripts/gen-env-reference.sh` y commitea el .md.
#
# README, docs/deployment.md, etc. NO repiten estas tablas — todos linkean
# a la página generada.
# ============================================================================


# ---- ClickHouse ----

# Usuario del cliente HTTP. El compose lo crea con
# `CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1` para que pueda emitir DDL.
CLICKHOUSE_USER=faro

# Password del usuario. En producción reemplazalo por algo generado con
# `openssl rand -base64 32`.
CLICKHOUSE_PASSWORD=faro

# Puerto HTTP del contenedor de ClickHouse expuesto al host (API REST).
# Es lo que usa el backend para queries y bulk inserts.
CLICKHOUSE_HTTP_PORT=8123

# Puerto del protocolo nativo de ClickHouse expuesto al host. Sólo para
# inspección manual con el CLI; el backend no lo usa.
CLICKHOUSE_NATIVE_PORT=9000


# ---- Redis ----

# Puerto de Redis expuesto al host. Está reservado para el futuro buffer
# durable de ingesta — hoy el contenedor corre pero ningún componente lo
# consume.
REDIS_PORT=6379


# ---- Puertos del backend ----

# Puerto donde el backend sirve la API REST (`/api/v1/*`), SSE y `/healthz`.
FARO_API_PORT=8080

# Puerto del listener OTLP/HTTP+JSON. Acepta `/v1/logs`, `/v1/traces`,
# `/v1/metrics` de cualquier exportador OpenTelemetry oficial.
FARO_OTLP_HTTP_PORT=4318

# Puerto del listener OTLP/gRPC. Misma superficie OTLP pero con codec
# protobuf — los SDKs oficiales de OTel lo usan por default.
FARO_OTLP_GRPC_PORT=4317

# Token Bearer aceptado por `/api/v1/ingest/logs` y los receptores OTLP.
# En producción rotalo con `openssl rand -hex 32`.
FARO_INGEST_TOKEN=dev-ingest-token


# ---- Bootstrap (primer arranque) ----
#
# El backend crea un proyecto y un usuario admin la primera vez que la BD
# está vacía. Después del primer arranque, cambiar estos valores NO migra
# los registros existentes — editalos desde el dashboard.

# Slug del proyecto seed (segmento de URL y prefijo en logs).
FARO_BOOTSTRAP_PROJECT_SLUG=default

# Nombre humano del proyecto seed (lo que muestra el dashboard).
FARO_BOOTSTRAP_PROJECT_NAME=Default

# Token Bearer del proyecto seed para ingesta. En producción tiene que
# ser un secret real.
FARO_BOOTSTRAP_INGEST_TOKEN=dev-ingest-token

# Email del admin seed. Será el primer login del dashboard.
FARO_BOOTSTRAP_ADMIN_EMAIL=admin@local.test

# Password del admin seed (almacenado hasheado). Cambialo apenas entres
# por primera vez al dashboard.
FARO_BOOTSTRAP_ADMIN_PASSWORD=admin12345

# Nombre humano del admin seed (aparece en la UI).
FARO_BOOTSTRAP_ADMIN_NAME=Admin


# ---- Frontend ----

# Puerto del dashboard SvelteKit expuesto al host.
FRONTEND_PORT=3000

# Origin permitido por SvelteKit (header `Origin` para CSRF). Cambialo al
# dominio público cuando despliegues con HTTPS (ej. `https://faro.example.com`).
FRONTEND_ORIGIN=http://localhost:3000

# URL base que el frontend usa para llamar al backend. Se inlinea en
# tiempo de build, así que un cambio acá requiere rebuild del contenedor
# del frontend.
PUBLIC_API_BASE=http://localhost:8080


# ---- Logging ----

# Filtro de `tracing-subscriber` (formato `RUST_LOG`). `info` global y
# `debug` para los módulos del propio crate `faro`.
RUST_LOG=info,faro=debug


# ============================================================================
# Tunables avanzados (descomentar sólo para anular el default del código)
# ============================================================================
# Las variables de abajo no se necesitan para un dev típico — todas tienen
# un default razonable en `backend/src/config.rs`. Las dejo enumeradas acá
# para que aparezcan en `docs/reference/environment.md` y para que sean
# fáciles de descubrir cuando hay que tunear.


# ---- Cliente ClickHouse (backend) ----

# URL del servicio ClickHouse vista por el backend. En el docker-compose
# de dev ya viene hardcodeada apuntando al hostname del servicio
# (`http://clickhouse:8123`); sólo hace falta setearla cuando corres el
# backend fuera del compose.
# CLICKHOUSE_URL=http://localhost:8123

# Nombre de la base de datos a usar. Si no existe, las migraciones la
# crean en el primer arranque.
# CLICKHOUSE_DATABASE=faro

# Máximo de conexiones HTTP idle que el cliente del backend mantiene
# cacheadas hacia ClickHouse. Cap a 1 para evitar que un typo (`0`)
# desactive el pool y mate throughput.
# FARO_CLICKHOUSE_POOL_MAX_IDLE=64


# ---- Listeners (override de los puertos del compose) ----

# Address completo del listener REST. Anula a `FARO_API_PORT` si lo necesitás
# bindear a una interfaz específica.
# FARO_API_ADDR=0.0.0.0:8080

# Address del listener OTLP/HTTP. Anula a `FARO_OTLP_HTTP_PORT`.
# FARO_BIND_ADDR=0.0.0.0:4318

# Address del listener OTLP/gRPC. Anula a `FARO_OTLP_GRPC_PORT`.
# FARO_OTLP_GRPC_ADDR=0.0.0.0:4317


# ---- Limites de SSE y rate limit de ingesta ----

# Tope de subscriptores SSE simultáneos por proyecto. Sin tope un cliente
# abriendo tabs en loop puede inflar el broadcast channel y el conteo de
# conexiones HTTP.
# FARO_SSE_MAX_PER_PROJECT=10

# Tope global de subscriptores SSE en el proceso. Acota el daño aun cuando
# un atacante itere por proyectos para evitar el cap por-proyecto.
# FARO_SSE_MAX_GLOBAL=100

# Records/segundo aceptados por proyecto en cualquier endpoint de ingesta
# (OTLP/HTTP, OTLP/gRPC, `/logs`). Burst = 2× este valor.
# FARO_INGEST_RATE_PER_SECOND=5000


# ---- Batching del writer ----

# Umbral de flush por tabla — el writer hace insert cuando acumula este
# número de filas o cuando vence `FARO_BATCH_FLUSH_MS`, lo que ocurra
# primero.
# FARO_BATCH_MAX_ROWS=5000

# Tiempo máximo (ms) que el writer espera para flushear una tabla aunque
# no haya alcanzado `FARO_BATCH_MAX_ROWS`.
# FARO_BATCH_FLUSH_MS=750

# URL de Redis. Hoy el backend NO la usa para nada productivo — está
# reservada para el futuro buffer durable de ingesta. El compose la
# inyecta como `redis://redis:6379` y el código la lee, pero no la usa.
# REDIS_URL=redis://redis:6379


# ---- Seguridad / endurecimiento ----

# Si está definido, `/metrics` exige `Authorization: Bearer <token>` y
# rechaza cualquier otra cosa con 401. Vacío/sin definir = endpoint
# abierto (apropiado para dev o cuando `/metrics` no es accesible
# públicamente).
# FARO_METRICS_TOKEN=

# Si `true`, el backend agrega `Strict-Transport-Security` a las respuestas
# del dashboard. El browser cachea HSTS por un año por origen, así que
# encenderlo en dev rompe testing en HTTP. Activar SÓLO en producción con
# TLS estable.
# FARO_ENABLE_HSTS=false

# URL pública del backend, usada por el backend mismo para armar enlaces
# absolutos (ej. el reset-password de email). Cambialo al dominio público
# cuando expongas la API.
# FARO_PUBLIC_BASE_URL=http://localhost:8080


# ---- Detector de anomalías por z-score ----

# Activa el worker que compara la tasa actual de cada (proyecto, servicio,
# señal) contra la misma franja horaria de los últimos 7 días y dispara
# incidentes en `faro.alert_incidents` cuando el z-score se desvía.
# FARO_ANOMALY_ENABLED=true

# Cadencia (segundos) con la que el worker re-evalúa todas las series.
# FARO_ANOMALY_INTERVAL_SECS=300

# Ventana en minutos para la observación actual y para cada muestra
# histórica. 5 balancea sensibilidad a spikes cortos vs ruido de Poisson.
# FARO_ANOMALY_WINDOW_MINUTES=5

# Z-score a partir del cual se dispara el incidente.
# FARO_ANOMALY_Z_FIRE=3.0

# Z-score por debajo del cual se resuelve el incidente. Hysteresis para no
# aletear en el borde.
# FARO_ANOMALY_Z_RESOLVE=1.5

# Baseline mínimo de errors/min para considerar la serie "interesante".
# Evita que una sola observación contra media casi-cero produzca z-score
# astronómico.
# FARO_ANOMALY_MIN_BASELINE_ERRORS=2.0

# Baseline mínimo de p95 (ms) de spans para considerar la serie.
# FARO_ANOMALY_MIN_BASELINE_P95_MS=20.0

# Baseline mínimo de logs/min para considerar la serie.
# FARO_ANOMALY_MIN_BASELINE_LOGS=50.0


# ---- Rollback recomendado por feature flags ----

# Activa el worker que cruza `$feature_exposure` con `error_events` vía
# `trace_id` y dispara un incidente cuando la variante B del flag tiene
# mucha más tasa de errores que A.
# FARO_FEATURE_ROLLBACK_ENABLED=true

# Cadencia (segundos) con la que se re-evalúan flags expuestas recientemente.
# FARO_FEATURE_ROLLBACK_INTERVAL_SECS=300

# Ventana reciente (minutos) de exposures, product events trazados y errores.
# FARO_FEATURE_ROLLBACK_WINDOW_MINUTES=15

# Ratio B/A de tasa de errores a partir del cual se recomienda rollback.
# FARO_FEATURE_ROLLBACK_RATIO=5.0

# Ratio B/A por debajo del cual se resuelve el incidente abierto.
# FARO_FEATURE_ROLLBACK_RESOLVE_RATIO=2.0

# Mínimo de usuarios expuestos por variante para evaluar la señal.
# FARO_FEATURE_ROLLBACK_MIN_SAMPLE=20

# Mínimo de errores ligados a la variante B para evitar ruido de muestras chicas.
# FARO_FEATURE_ROLLBACK_MIN_TREATMENT_ERRORS=5


# ---- Compactador de fingerprints ----

# Activa el worker que agrupa errores semánticamente equivalentes
# (Jaccard ≥ umbral) que el hash exacto de `fingerprint.rs` deja como
# issues separados.
# FARO_FP_COMPACTOR_ENABLED=true

# Cadencia (segundos) del compactor.
# FARO_FP_COMPACTOR_INTERVAL_SECS=1800

# Umbral de similitud MinHash/Jaccard para fusionar dos fingerprints.
# FARO_FP_COMPACTOR_JACCARD=0.85


# ---- Detector de servicios stale ----

# Activa el worker que detecta servicios que dejaron de emitir tráfico.
# FARO_STALE_DETECTOR_ENABLED=true

# Cadencia (segundos) del detector.
# FARO_STALE_DETECTOR_INTERVAL_SECS=3600

# Horas sin tráfico tras las cuales un servicio se marca como stale.
# FARO_STALE_THRESHOLD_HOURS=24


# ---- Unificación de usuarios multi-device (goal 10.E.1) ----

# Activa el worker que mantiene `product_users` y `product_user_aliases`
# a partir de `product_events`. Sin esto, esas dos tablas quedan vacías y
# el endpoint `GET /api/v1/product-users/:id/events` (todos los eventos
# del user en cualquier device) responde sólo lo que matchea `distinct_id`
# directo, sin expandir a los anon_ids ligados.
# FARO_USER_UNIFIER_ENABLED=true

# Cadencia (segundos) entre ticks del unificador. Cada tick mira eventos
# desde `last_watermark - 30s` para no perder eventos justo después de un
# tick. Tope interno: 5 000 users/tick.
# FARO_USER_UNIFIER_INTERVAL_SECS=60


# ---- Session aggregator (goal 10.F.1) ----

# Activa el worker que sesionaliza `product_events` y mantiene
# `faro.product_sessions`. Si el SDK manda `session_id` en el evento, se
# respeta; si no, se cortan sesiones por gap > `FARO_SESSION_GAP_MINUTES`.
# FARO_SESSION_AGGREGATOR_ENABLED=true

# Cadencia (segundos) del agregador. 5 min es lo bastante fino para que las
# sesiones "vivas" se actualicen en near-real-time sin escanear
# `product_events` en cada request.
# FARO_SESSION_AGGREGATOR_INTERVAL_SECS=300

# Minutos de inactividad tras los cuales se considera que una sesión terminó
# y la siguiente actividad del mismo `(project, distinct_id)` arranca una
# nueva. 30 es la convención de GA/Mixpanel; cambiarlo recalcula
# retroactivamente el conteo de sesiones en ticks sucesivos.
# FARO_SESSION_GAP_MINUTES=30

# Cuánto hacia atrás mira el worker en cada tick. Debe ser >= a la duración
# máxima realista de una sesión activa — si una sesión sigue viva más allá
# de este horizonte, su `started_at` (y el `session_id` sintético) puede
# drift al fall out de la ventana en runs sucesivos. Para sesiones cuyo
# `session_id` viene del SDK no aplica el drift.
# FARO_SESSION_LOOKBACK_MINUTES=360


# ---- Notificaciones · Telegram ----

# Token global del bot de Telegram. Si está definido, los destinos
# `tg://<chat_id>` usan este bot. Los destinos `tg://<chat_id>@<token>`
# siempre pueden traer su propio token y no necesitan que esté configurado
# a nivel global. La integración guardada en BD (Settings → Integraciones)
# tiene prioridad sobre esta variable.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Base de la API de Telegram. Configurable sólo para pruebas — en
# producción usar el default.
# TELEGRAM_API_BASE=https://api.telegram.org


# ---- Self-observability ----

# Si `true`, el backend exporta sus propios logs y trazas vía OTLP al
# endpoint configurado abajo. Opt-in para evitar back-pressure cuando el
# listener no responde en frío (ver ADR-0007).
# FARO_SELF_OBSERVE=false

# Dónde mandar la telemetría del propio backend. Default: el listener
# OTLP local — el backend se observa a sí mismo.
# FARO_SELF_OBSERVE_ENDPOINT=http://localhost:4318

# Nombre de servicio que aparece en la telemetría auto-emitida.
# OTEL_SERVICE_NAME=faro-backend


# ---- Smoke test post-deploy (CI) ----

# Consumidos por `scripts/smoke-post-deploy.sh` desde el workflow
# `deploy.yml`. Si los tres están vacíos, el smoke salta los chequeos
# que requieren auth/ingest y sólo valida `/healthz` (deploy no se
# rompe; se emite `::warning::`).
#
# El smoke user DEBE ser un usuario dedicado SIN 2FA — Faro no soporta
# provisión automática de TOTP y el script falla si lo detecta.

# Email del usuario dedicado para el smoke test.
# FARO_SMOKE_EMAIL=smoke@example.com

# Password del usuario de smoke (setear en GitHub Secrets, no en plano).
# FARO_SMOKE_PASSWORD=

# Token Bearer del proyecto dedicado al smoke (slug "smoke" o similar).
# FARO_SMOKE_INGEST_TOKEN=
