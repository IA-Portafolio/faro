# Secrets / env
.env
.env.prod
.env.*.local

# Logs / coredumps
*.log
core.*
# `core.*` se come módulos legítimos llamados core.<ext>; re-incluir los del repo.
!frontend/src/lib/api/core.*

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Artefactos de tooling local (Playwright MCP, screenshots ad-hoc)
.playwright-mcp/

# Rust
backend/target/
cli/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# Node (frontend + npm SDKs)
node_modules/
frontend/.svelte-kit/
frontend/build/
frontend/.vercel/
sdks/_shared/sdk-core/dist/
sdks/node/dist/
sdks/nextjs/dist/
sdks/nextjs/.next/
sdks/expo/dist/
sdks/expo/.expo/
sdks/*/package-lock.json
sdks/_shared/sdk-core/package-lock.json

# Python SDK
__pycache__/
*.py[cod]
*.egg-info/
sdks/python/build/
sdks/python/dist/
sdks/python/.venv/
sdks/python/.pytest_cache/

# Flutter SDK
sdks/flutter/.dart_tool/
sdks/flutter/build/
sdks/flutter/.flutter-plugins
sdks/flutter/.flutter-plugins-dependencies

# Kotlin / Gradle SDK
sdks/kotlin/.gradle/
sdks/kotlin/build/
sdks/kotlin/.idea/
sdks/kotlin/local.properties

# Go SDK
sdks/go/vendor/

# Docs CI — cache local de lychee (link-checker). En CI lo persiste
# actions/cache; localmente es transitorio.
.lycheecache

# Backups locales ad-hoc (snapshots de src/, tarballs) — no van al repo
backups/

# Backups locales (secretos / datos) — nunca commitear
.env.prod.bak.*
backups/
