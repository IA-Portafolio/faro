{
  "name": "@faro/nextjs",
  "version": "0.1.0",
  "description": "Faro SDK for Next.js (App Router + Pages Router)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "import": "./dist/index.js", "require": "./dist/index.cjs", "types": "./dist/index.d.ts" },
    "./client": { "import": "./dist/client.js", "require": "./dist/client.cjs", "types": "./dist/client.d.ts" },
    "./server": { "import": "./dist/server.js", "require": "./dist/server.cjs", "types": "./dist/server.d.ts" }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": { "build": "tsup src/index.ts src/client.ts src/server.ts --format cjs,esm --dts --clean" },
  "peerDependencies": { "@faro/node": "^0.1.0", "next": ">=13" },
  "devDependencies": { "tsup": "^8.0.0", "typescript": "^5.4.0", "@types/node": "^20.0.0" }
}
