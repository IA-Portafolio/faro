{
  "name": "@iaportafolio/nextjs",
  "version": "0.3.0",
  "description": "Faro SDK for Next.js (App Router + Pages Router): RUM, Web Vitals, error capture, ErrorBoundary",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IA-Portafolio/faro.git",
    "directory": "sdks/nextjs"
  },
  "homepage": "https://github.com/IA-Portafolio/faro/tree/main/sdks/nextjs#readme",
  "bugs": "https://github.com/IA-Portafolio/faro/issues",
  "keywords": [
    "faro",
    "nextjs",
    "observability",
    "rum",
    "web-vitals",
    "logging",
    "telemetry"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/client.ts src/server.ts --format cjs,esm --dts --clean --external react --external next --external @iaportafolio/node --external rrweb",
    "test": "npm run build && node --test --test-force-exit test/browser.test.mjs"
  },
  "peerDependencies": {
    "@iaportafolio/node": "^0.3.0",
    "next": ">=13",
    "react": ">=16.8.0",
    "rrweb": "^2.0.0-alpha.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "rrweb": {
      "optional": true
    }
  },
  "dependencies": {
    "web-vitals": "^6.2.0"
  },
  "devDependencies": {
    "@iaportafolio/node": "^0.3.0",
    "@iaportafolio/sdk-core": "file:../_shared/sdk-core",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  }
}
