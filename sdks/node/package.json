{
  "name": "@iaportafolio/node",
  "version": "0.3.0",
  "description": "Faro SDK for Node.js and TypeScript — logs, errors, product events and auto-instrumented OTLP traces",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./instrument": {
      "types": "./dist/instrument.d.ts",
      "import": "./dist/instrument.js",
      "require": "./dist/instrument.cjs"
    },
    "./tracing": {
      "types": "./dist/tracing.d.ts",
      "import": "./dist/tracing.js",
      "require": "./dist/tracing.cjs"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "import": "./dist/pino.js",
      "require": "./dist/pino.cjs"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "import": "./dist/winston.js",
      "require": "./dist/winston.cjs"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js",
      "require": "./dist/express.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IA-Portafolio/faro.git",
    "directory": "sdks/node"
  },
  "homepage": "https://github.com/IA-Portafolio/faro/tree/main/sdks/node#readme",
  "bugs": "https://github.com/IA-Portafolio/faro/issues",
  "keywords": [
    "faro",
    "observability",
    "logging",
    "logs",
    "telemetry",
    "tracing",
    "otel",
    "opentelemetry",
    "otlp",
    "pino",
    "winston"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/instrument.ts src/tracing.ts src/pino.ts src/winston.ts src/express.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts src/instrument.ts src/tracing.ts src/pino.ts src/winston.ts src/express.ts --format esm --dts --watch",
    "test": "npm run build && node --test --test-force-exit test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation": "^0.219.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-trace-node": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.34.0"
  },
  "peerDependencies": {
    "pino-abstract-transport": ">=1.0.0",
    "winston-transport": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pino-abstract-transport": {
      "optional": true
    },
    "winston-transport": {
      "optional": true
    }
  },
  "devDependencies": {
    "@iaportafolio/sdk-core": "file:../_shared/sdk-core",
    "@types/node": "^20.0.0",
    "pino-abstract-transport": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "winston-transport": "^4.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
