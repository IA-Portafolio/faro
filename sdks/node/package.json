{
  "name": "@iaportafolio/node",
  "version": "0.1.0",
  "description": "Faro SDK for Node.js and TypeScript",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "repository": { "type": "git", "url": "git+https://github.com/IA-Portafolio/faro.git", "directory": "sdks/node" },
  "homepage": "https://github.com/IA-Portafolio/faro/tree/main/sdks/node#readme",
  "bugs": "https://github.com/IA-Portafolio/faro/issues",
  "keywords": ["faro", "observability", "logging", "logs", "telemetry", "otel"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch"
  },
  "engines": { "node": ">=18" },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^25.9.1"
  }
}
