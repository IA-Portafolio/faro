{
  "name": "@iaportafolio/browser",
  "version": "0.1.0",
  "description": "Faro SDK for browser apps — error capture, Web Vitals, breadcrumbs, React ErrorBoundary",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": ["dist", "src", "README.md"],
  "repository": { "type": "git", "url": "git+https://github.com/IA-Portafolio/faro.git", "directory": "sdks/browser" },
  "homepage": "https://github.com/IA-Portafolio/faro/tree/main/sdks/browser#readme",
  "bugs": "https://github.com/IA-Portafolio/faro/issues",
  "keywords": ["faro", "observability", "browser", "rum", "web-vitals", "error-tracking"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format cjs,esm --dts --clean --external react"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true }
  },
  "dependencies": {
    "web-vitals": "^4.2.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/react": "^18.0.0",
    "react": "^18.0.0"
  }
}
