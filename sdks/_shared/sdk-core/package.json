{
  "name": "@iaportafolio/sdk-core",
  "version": "0.1.0",
  "description": "Funciones puras compartidas por los SDKs TS de Faro (scrubbing + feature flags). No se publica: cada SDK la inlinea en su bundle vía tsup.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./feature-flags": "./src/feature-flags.ts",
    "./scrub": "./src/scrub.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "npm run build && node --test --test-force-exit test/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3"
  }
}
