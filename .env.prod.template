# ============================================================================
# Faro · Plantilla de variables para producción
#
# La referencia completa con descripción y default de CADA variable que
# entiende Faro está en docs/reference/environment.md (generada desde el
# .env.example del repo).
#
# Este archivo es un DELTA: sólo lista los valores que típicamente difieren
# entre dev y prod (puertos, password, dominio público, smoke test). El
# resto hereda los defaults del código.
# ============================================================================

CLICKHOUSE_USER=faro
# CLICKHOUSE_PASSWORD set during deploy
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
REDIS_PORT=6379

FARO_API_PORT=8080
FARO_OTLP_HTTP_PORT=4318
# FARO_INGEST_TOKEN set during deploy

FRONTEND_PORT=3000
FRONTEND_ORIGIN=https://faro.iaportafolio.com
PUBLIC_API_BASE=https://faro.iaportafolio.com

# Token del bot de Telegram para notificaciones nativas (opcional).
# Si se define, las reglas de alerta aceptan destinos tipo tg://<chat_id>.
# También puedes inlining el token por destino: tg://<chat_id>@<token>.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

RUST_LOG=info,faro=debug

# ---------- Smoke test post-deploy ----------
# Consumidos por `.github/workflows/deploy.yml` step "Smoke test post-deploy"
# vía scripts/smoke-post-deploy.sh. Si los tres están vacíos, el smoke se salta
# los chequeos que requieren auth/ingest y sólo valida /healthz (no se rompe
# el deploy, sólo imprime ::warning::). Para tener cobertura real del round-trip
# completo (login → ingest → query) hay que llenarlos.
#
# El smoke user DEBE ser un usuario dedicado SIN 2FA: el script detecta
# `needs_totp: true` y falla con un mensaje claro (Faro no soporta provisión
# automática de TOTP, no podemos calcular el código en CI).
# FARO_SMOKE_EMAIL=smoke@iaportafolio.com
# FARO_SMOKE_PASSWORD=<set during deploy>
# FARO_SMOKE_INGEST_TOKEN=<bearer de un proyecto, p.ej. el slug 'smoke'>

