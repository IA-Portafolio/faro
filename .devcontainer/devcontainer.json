{
  "name": "Faro",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/rust:1": { "version": "stable", "profile": "default" },
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/go:1": { "version": "1.22" },
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installGradle": true },
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },

  "forwardPorts": [3000, 5173, 8080, 4318, 8123],
  "portsAttributes": {
    "3000":  { "label": "frontend (container)" },
    "5173":  { "label": "frontend (vite dev)" },
    "8080":  { "label": "backend API + SSE" },
    "4318":  { "label": "OTLP/HTTP" },
    "8123":  { "label": "ClickHouse HTTP" }
  },

  "postCreateCommand": "cp -n .env.example .env || true && cd frontend && (npm ci || npm install) && cd ../backend && cargo fetch",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "svelte.svelte-vscode",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "ms-python.python",
        "golang.go",
        "Dart-Code.dart-code",
        "Dart-Code.flutter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
        "[typescript]": { "editor.defaultFormatter": "vscode.typescript-language-features" },
        "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" }
      }
    }
  },

  "remoteUser": "vscode"
}
